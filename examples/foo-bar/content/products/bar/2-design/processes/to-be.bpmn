<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:statera="urn:statera:bpmn:1.0" id="Definitions_Process_Bar_ToBe" targetNamespace="urn:statera:processes" exporter="statera (statera bpmn)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_Process_Bar_ToBe">
    <bpmn:participant id="Pool_Process_Bar_ToBe" name="Bar monthly production (TO-BE)" processRef="Process_Bar_ToBe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Bar_ToBe" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Bar_ToBe">
      <bpmn:lane id="Lane_Pipeline" name="Pipeline (statera run)" statera:role="data-team">
        <bpmn:flowNodeRef>Start_CutDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Cut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Transform</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Controls</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Controls</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Package</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Team" name="Bar technical team" statera:role="bar-team">
        <bpmn:flowNodeRef>Task_Investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Published</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_CutDate" name="Calendar cut-off date">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_Start_CutDate" />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="Event_Cut" name="foo cut available" statera:awaits="py:statera.collect.pin_cut">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_Event_Cut" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_Transform" name="Compute the product tables (dbt build)" statera:type="automatic" statera:gsbpm="5.3-5.7" statera:durationMin="1" statera:implementation="dbt:build" statera:models="stg_foo__records,int_bar__records,bar_uf_monthly,bar_uf_monthly_change">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Controls" name="Check contracts and controls across editions" statera:type="automatic" statera:gsbpm="6.2" statera:durationMin="1" statera:implementation="py:statera.analyse.step">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Controls" name="Controls OK?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Package" name="Generate xlsx, summary and Data Package" statera:type="automatic" statera:gsbpm="6.4;7.2" statera:durationMin="1" statera:implementation="py:statera.disseminate.step">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Investigate" name="Investigate the failure" statera:type="manual" statera:gsbpm="5.3" statera:durationMin="60" statera:exception="true">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Approve" name="Review and approve the release" statera:type="manual" statera:gsbpm="6.5" statera:durationMin="30">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approved?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Publish" name="Publish the package" statera:type="semi-automatic" statera:gsbpm="7.3" statera:durationMin="10" statera:implementation="py:statera.disseminate.publish">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Published" name="Edition published">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_CutDate" targetRef="Event_Cut" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Event_Cut" targetRef="Task_Transform" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Transform" targetRef="Task_Controls" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Controls" targetRef="Gateway_Controls" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_Controls" targetRef="Task_Package" name="yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == 'ok'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_Controls" targetRef="Task_Investigate" name="no">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == 'failed'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Investigate" targetRef="Task_Transform" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Package" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Approve" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_Approved" targetRef="Task_Publish" name="yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == 'approved'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_Approved" targetRef="Task_Approve" name="no">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == 'rejected'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Publish" targetRef="End_Published" />
  </bpmn:process>
