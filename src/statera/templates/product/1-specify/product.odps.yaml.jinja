# Data product descriptor (ODPS v1.0). Output ports point to the product's ODCS contracts.
{%- if alignment != 'consumer' %}
# INTERNAL product ({{ alignment }}): not disseminated. Releases CUTS (immutable manifests) to its
# authorized consumers; see specification 09 (internal products, cuts and references over time).
{%- endif %}
apiVersion: v1.0.0
kind: DataProduct
id: {{ product }}
name: {{ title }}
version: 0.1.0
status: draft
domain: tbd
description:
  purpose: TBD.
  usage: TBD.
  limitations: TBD.
customProperties:
  - {property: alignment, value: {{ alignment }}}
  - {property: visibility, value: {{ 'public' if alignment == 'consumer' else 'internal' }}}
{%- if alignment == 'consumer' %}
  - {property: theme, value: {{ theme }}}
  - {property: frequency, value: {{ frequency }}}
  - {property: purpose, value: {{ purpose }}}
  # Where the public accesses the product while it has no series (7-disseminate/series.yaml): the files
  # published today, in DCAT vocabulary. Required at level 1. E.g.:
  # [{title: "Bulletin (spreadsheet)", format: xlsx, url: "https://…", updated: annual, ports: [uf-sheet]}]
  - {property: distributions, value: []}
{%- else %}
  # Who may read this product and for what purpose (purpose limitation, e.g. LGPD art. 6, I). Required at level 1.
  # E.g.: [{product: employment-flows, purpose: "monthly statistics of formal employment flows"}]
  - {property: authorizedConsumers, value: []}
{%- endif %}
  - {property: urn, value: {{ namespace }}.{{ product }}}
  # Target conformance level (specification 08). 0 = draft: `statera validate` accepts the skeleton and
  # `statera conformance` shows what is missing. Raise it to 1 once the product is specified.
  - {property: conformanceLevel, value: 0}
{%- if alignment == 'consumer' %}
  - {property: legacyParity, value: not-declared}
{%- endif %}
outputPorts: []
