# Who answers for the product. Roles, not people. Paths are relative to the product folder.
scope: product
unit: {{ product }}
curator: {{ curator }}
technical_owner: {{ technical_owner }}
required_reviewers: [{{ technical_owner }}]
data_protection_officer: {{ data_protection_officer }}
paths:
  - {pattern: /, roles: [{{ technical_owner }}]}
  - {pattern: /1-specify/classification.yaml, roles: [{{ data_protection_officer }}]}
