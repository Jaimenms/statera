{
  "yaml.schemas": {
    ".venv/lib/python3.12/site-packages/statera/schemas/standards/odcs-json-schema-v3.1.0.json": [
      "**/*.odcs.yaml"
    ],
    ".venv/lib/python3.12/site-packages/statera/schemas/standards/odps-json-schema-v1.0.0.json": "content/products/*/1-specify/product.odps.yaml",
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/classification.schema.json": "content/*/*/1-specify/classification.yaml",
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/owners.schema.json": [
      "content/*/*/1-specify/owners.yaml",
      "content/governance/shared-owners.yaml"
    ],
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/roles.schema.json": "content/governance/roles.yaml",
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/calendar.schema.json": "content/products/*/1-specify/calendar.yaml",
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/process.schema.json": ["content/*/*/2-design/process.yaml", "content/governance/processes/*.yaml"],
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/rule-cases.schema.json": "content/*/*/5-process/rules/*/cases.yaml",
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/metrics.schema.json": "content/*/*/5-process/metrics.yaml",
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/controls.schema.json": "content/products/*/6-analyse/controls.yaml",
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/publication-series.schema.json": "content/products/*/7-disseminate/series.yaml",
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/indicators.schema.json": "content/products/*/8-evaluate/indicators.yaml",
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/query.schema.json": "**/queries/**/query.yaml",
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/query-test.schema.json": "**/queries/**/test.yaml"
  },
  "json.schemas": [
    {
      "fileMatch": [
        "**/7-disseminate/data/**/datapackage.json",
        "publications/**/*.datapackage.json"
      ],
      "url": "./.venv/lib/python3.12/site-packages/statera/schemas/standards/datapackage-2.0.json"
    }
  ],
  "files.exclude": {
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/__pycache__": true
  },
  "files.associations": {
    "*.sql": "jinja-sql",
    "*.yml": "jinja-yaml"
  },
  "files.readonlyInclude": {
    "content/dbt_project.yml": true,
    "content/dbt/generated/*.yml": true,
    "content/docs/**": true,
    ".github/CODEOWNERS": true
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "dbt.allowListFolders": [
    "content/dbt_project.yml"
  ]
}
