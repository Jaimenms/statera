{
  // Day-to-day commands (Terminal > Run Task…, or Ctrl/Cmd+Shift+B for `check`). They call
  // `uv run statera …`, which uses the Statera version this repository pins, on Windows, Linux and Mac.
  // The production tasks add `--all-groups` (dbt and the legacy-code readers); doctor needs none of them.
  // The same commands work in any terminal as `statera …` once Statera is installed globally
  // (uv tool install git+ssh://git@github.com/Jaimenms/statera.git).
  "version": "2.0.0",
  "options": {"cwd": "${workspaceFolder}"},
  "presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
  "tasks": [
    {
      "label": "statera: check",
      "detail": "What CI runs: validation, lint and fast tests",
      "type": "process", "command": "uv", "args": ["run", "--all-groups", "statera", "check"],
      "group": {"kind": "build", "isDefault": true}, "problemMatcher": []
    },
    {
      "label": "statera: check (all tests)",
      "detail": "Also the slow tests (full process with dbt)",
      "type": "process", "command": "uv", "args": ["run", "--all-groups", "statera", "check", "--all"],
      "group": "test", "problemMatcher": []
    },
    {
      "label": "statera: doctor",
      "detail": "Checks the computer and the repository; says how to fix each problem",
      "type": "process", "command": "uv", "args": ["run", "statera", "doctor"], "problemMatcher": []
    },
    {
      "label": "statera: sync",
      "detail": "Regenerates the generated files (dbt_project.yml, internal calendars, BPMN, CODEOWNERS…)",
      "type": "process", "command": "uv", "args": ["run", "--all-groups", "statera", "sync"], "problemMatcher": []
    },
    {
      "label": "statera: conformance",
      "detail": "Conformance level of each product and what is missing for the next one",
      "type": "process", "command": "uv", "args": ["run", "--all-groups", "statera", "conformance"], "problemMatcher": []
    },
    {
      "label": "statera: new product",
      "type": "process", "command": "uv",
      "args": ["run", "--all-groups", "statera", "new-product", "${input:productName}", "--alignment", "${input:alignment}"],
      "problemMatcher": []
    },
    {
      "label": "statera: run edition",
      "detail": "Runs an edition through the to-be process (stops at the first human task)",
      "type": "process", "command": "uv",
      "args": ["run", "--all-groups", "statera", "run", "--product", "${input:product}", "--period", "${input:period}",
               "--with-dependencies"],
      "problemMatcher": []
    },
    {
      "label": "statera: resume edition",
      "detail": "Completes the pending human task and continues",
      "type": "process", "command": "uv",
      "args": ["run", "--all-groups", "statera", "resume", "--product", "${input:product}", "--period", "${input:period}"],
      "problemMatcher": []
    },
    {
      "label": "statera: edition status",
      "type": "process", "command": "uv",
      "args": ["run", "--all-groups", "statera", "status", "--product", "${input:product}", "--period", "${input:period}"],
      "problemMatcher": []
    },
    {
      "label": "statera: docs",
      "detail": "Regenerates the documentation in content/docs/",
      "type": "process", "command": "uv", "args": ["run", "--all-groups", "statera", "docs"], "problemMatcher": []
    },
    {
      "label": "statera: catalog",
      "detail": "Browsable, searchable catalog in content/target/static_index.html",
      "type": "process", "command": "uv", "args": ["run", "--all-groups", "statera", "docs", "--interactive"], "problemMatcher": []
    },
    {
      "label": "statera: demo",
      "detail": "Demo from scratch (synthetic data only: deletes data/ and the editions register)",
      "type": "process", "command": "uv", "args": ["run", "--all-groups", "statera", "demo"], "problemMatcher": []
    },
    {
      "label": "statera: clean",
      "detail": "Deletes local data and artifacts (keeps the editions register)",
      "type": "process", "command": "uv", "args": ["run", "--all-groups", "statera", "clean"], "problemMatcher": []
    }
  ],
  "inputs": [
    {"id": "product", "type": "promptString", "description": "Product (folder name in content/products/)"},
    {"id": "period", "type": "promptString", "description": "Reference period, e.g. 2026-06"},
    {"id": "productName", "type": "promptString", "description": "New product name (lowercase and hyphens)"},
    {
      "id": "alignment", "type": "pickString", "description": "Alignment", "default": "consumer",
      "options": ["consumer", "aggregate", "source"]
    }
  ]
}
