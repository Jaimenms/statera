{
  // Abra por aqui (File > Open Workspace from File): cada pasta é uma raiz, e as configurações de
  // content/.vscode/ (esquemas YAML, interpretador, associações) passam a valer.
  "folders": [
    {"name": "content", "path": "content"},
    {"name": "publications", "path": "publications"},
    {"name": "docs", "path": "docs"},
    {"name": "(raiz: README, Makefile, .github)", "path": "."}
  ],
  "settings": {
    "files.exclude": {"**/.hypothesis": true, "**/.pytest_cache": true, "**/.ruff_cache": true},
    // dbt Power User: só o projeto dbt de content/. A lista vale para cada pasta, relativa a ela, e
    // compara por prefixo; caminhos inexistentes são descartados e lista vazia não filtra nada. Na
    // raiz, só o Makefile existe: a lista fica ["Makefile"] e exclui content/ (já aberto à parte).
    "dbt.allowListFolders": ["dbt_project.yml", "Makefile"]
  }
}
