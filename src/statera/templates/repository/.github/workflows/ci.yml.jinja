# Continuous integration of the data repository: validates and tests on every pull request.
# Statera comes from a git repository (pyproject.toml). If it is private, create a read-only deploy
# key on it and store the private key in the STATERA_SSH_KEY secret.
name: ci

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

env:
  STATERA_REQUIRE: pspp,r  # requires the rule cases that use legacy code (SPSS and R)

jobs:
  validate:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
      - uses: webfactory/ssh-agent@v0.9.0
        with: {ssh-private-key: "${{ '${{' }} secrets.STATERA_SSH_KEY {{ '}}' }}"}
      - uses: astral-sh/setup-uv@v6
      - name: GNU PSPP and R (legacy code called by Python models)
        run: sudo apt-get update -q && sudo apt-get install -y -q pspp r-base-core
      # `uv run --locked` uses exactly the Statera version in uv.lock and fails if the lock is out of date;
      # `--all-groups` adds the production tools (dbt, legacy code readers), which reading the data does not need
      - run: uv run --locked --all-groups statera check --all
