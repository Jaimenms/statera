{
  "yaml.schemas": {
    ".venv/lib/python3.12/site-packages/statera/schemas/standards/odcs-json-schema-v3.1.0.json": [
      "**/*.odcs.yaml"
    ],
    ".venv/lib/python3.12/site-packages/statera/schemas/standards/odps-json-schema-v1.0.0.json": "products/*/1-specify/product.odps.yaml",
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/classification.schema.json": "*/*/1-specify/classification.yaml",
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/owners.schema.json": [
      "*/*/1-specify/owners.yaml",
      "governance/shared-owners.yaml"
    ],
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/roles.schema.json": "governance/roles.yaml",
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/calendar.schema.json": "products/*/1-specify/calendar.yaml",
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/process.schema.json": "*/*/2-design/processes/*.yaml",
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/rule-cases.schema.json": "*/*/5-process/rules/*/cases.yaml",
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/metrics.schema.json": "*/*/5-process/metrics.yaml",
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/controls.schema.json": "products/*/6-analyse/controls.yaml",
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/publication-series.schema.json": "products/*/7-disseminate/series.yaml",
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/indicators.schema.json": "products/*/8-evaluate/indicators.yaml",
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/query.schema.json": "**/queries/**/query.yaml",
    ".venv/lib/python3.12/site-packages/statera/schemas/statera/query-test.schema.json": "**/queries/**/test.yaml"
  },
  "json.schemas": [
    {
      "fileMatch": [
        "**/7-disseminate/data/**/datapackage.json",
        "**/publications/**/*.datapackage.json"
      ],
      "url": "./.venv/lib/python3.12/site-packages/statera/schemas/standards/datapackage-2.0.json"
    }
  ],
  "files.exclude": {
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/__pycache__": true
  },
  "files.associations": {
    "*.sql": "jinja-sql",
    "*.yml": "jinja-yaml"
  },
  "files.readonlyInclude": {
    "dbt_project.yml": true,
    "dbt/generated/*.yml": true,
    "docs/**": true
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  }
}
