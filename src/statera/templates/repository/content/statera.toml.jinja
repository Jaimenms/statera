# Data repository following the Statera standard. Read by the `statera` framework (dependency in pyproject.toml).

[project]
name = "{{ name }}"
organization = "{{ organization }}"
acronym = "{{ acronym }}"
namespace = "{{ namespace }}"
specification = "0.1"
required_version = "~={{ statera_version }}"  # Statera versions this repository accepts (see pyproject.toml)
repository_root = ".."             # repository root (where .github/, publications/, docs/ live)
synthetic = false

[engine]
type = "duckdb"                    # in production: postgres, trino...
path = "dbt/data/warehouse.duckdb"

[consumption]
# Where those who only READ the data (outside the data team) read it from: a shared engine the team keeps
# up to date. Without it, the local engine above, which only exists where `statera run` has run.
# STATERA_ENGINE overrides it (for a URL with credentials, which never goes into git); `local` forces the
# local engine. A DuckDB file is opened read-only: a path (network share), https:// or s3://.
# engine = "s3://my-bucket/statistics/warehouse.duckdb"
# engine = "postgres://reader@db.example.org/statistics"   # or any engine Ibis reads (statera[postgres], [trino]…)
# engine = "athena://?s3_staging_dir=s3://my-results/statera/&region_name=us-east-1"  # statera[athena]
#
# Any other source is a connector of this repository (a function that returns an Ibis backend, chosen by the
# URL's scheme) or of an installed package (entry point "statera.connectors"). Specification 07.
# [consumption.connectors]
# parquet+s3 = "connectors/parquet_s3.py:connect"
# Likewise, a reader opens the publication storage of the editions (files_url in series.yaml) when it is
# not a share or https://: a function read(url, project) -> bytes ("statera.readers" in a package).
# [consumption.readers]
# s3 = "readers/s3.py:read"

[conventions]
# Names of the convention columns in YOUR data (column names belong to the content). These are the
# defaults; change them if your tables use other names (e.g. period_column = "reference_month").
period_column = "period"           # reference period of an edition (e.g. 2026-06)
cut_date_column = "cut_date"       # cut-off date of the extraction
valid_from_column = "valid_from"   # start of validity, in reference tables with a validity period
valid_to_column = "valid_to"       # end of validity (empty = currently valid)

[dbt]
folder = "dbt"
project = "{{ name | replace('-', '_') }}"
profile = "{{ name | replace('-', '_') }}"

[registry]
editions = "../publications"       # editions register

[openlineage]
namespace = "{{ namespace }}"
