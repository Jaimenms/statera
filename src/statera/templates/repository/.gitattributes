# Line endings: LF in the repository and in every checkout, Windows included, so file hashes, diffs and
# generated files are identical on every computer (and in CI).
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never normalized or diffed as text
*.xlsx binary
*.parquet binary
*.duckdb binary
*.sav binary
*.rds binary
*.png binary
*.jpg binary
*.pdf binary

# Files GENERATED by the Statera framework at the root (those in content/ are in content/.gitattributes).
.github/CODEOWNERS           linguist-generated=true
