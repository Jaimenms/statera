{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:statera:schema:controls:0.1",
  "title": "Controles declarativos da edição (GSBPM 6.2)",
  "type": "object",
  "required": [
    "controls"
  ],
  "additionalProperties": false,
  "properties": {
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "port"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CK-[0-9]{2}$"
          },
          "name": {
            "type": "string"
          },
          "port": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "type": {
            "enum": [
              "revision-between-editions",
              "outlier"
            ]
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "revision-between-editions"
                }
              }
            },
            "then": {
              "required": [
                "key",
                "measures",
                "relative_base",
                "warning_threshold",
                "error_threshold"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "outlier"
                }
              }
            },
            "then": {
              "required": [
                "measure",
                "factor"
              ]
            }
          }
        ]
      }
    }
  }
}
