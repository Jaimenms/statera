{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:statera:schema:publication-series:0.1",
  "title": "Catalog entry of a publication series",
  "description": "Describes the series (stable). Each edition is recorded outside the code repository, in the editions register (`edition_registry`).",
  "type": "object",
  "required": [
    "series",
    "title",
    "product",
    "frequency",
    "license",
    "files_per_edition",
    "revision_policy",
    "correction_policy",
    "edition_registry",
    "main_resource"
  ],
  "additionalProperties": false,
  "properties": {
    "series": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "product": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Folder in products/ (tables = ODPS output ports)."
    },
    "frequency": {
      "enum": [
        "monthly",
        "quarterly",
        "semiannual",
        "annual",
        "biweekly"
      ]
    },
    "start": {
      "type": "string",
      "pattern": "^[0-9]{4}(-[0-9]{2})?$"
    },
    "license": {
      "type": "object",
      "required": [
        "name",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "description": "In the format of Frictionless Data Package licenses."
    },
    "page": {
      "type": "string",
      "format": "uri",
      "description": "Series page on the portal, where the public downloads the editions (dcat:landingPage)."
    },
    "files_url": {
      "type": "string",
      "minLength": 1,
      "description": "Publication storage of each edition's files, with {period} (and optionally {product}): an https:// URL or a network path. The library reads published editions from it when they are not in the local publication folder, checking each file against the hash in the register. E.g. https://data.example.org/bar/{period}/"
    },
    "open_data_portal": {
      "type": "object",
      "required": [
        "organization",
        "dataset"
      ],
      "properties": {
        "organization": {
          "type": "string"
        },
        "dataset": {
          "type": "string"
        }
      }
    },
    "files_per_edition": {
      "type": "object",
      "required": [
        "tables",
        "spreadsheet",
        "summary"
      ],
      "properties": {
        "tables": {
          "type": "string",
          "pattern": "\\{port\\}"
        },
        "spreadsheet": {
          "type": "string",
          "pattern": "\\{period\\}"
        },
        "summary": {
          "type": "string"
        },
        "metadata": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "type": "string"
    },
    "revision_policy": {
      "type": "string"
    },
    "correction_policy": {
      "type": "string"
    },
    "edition_registry": {
      "type": "object",
      "required": [
        "edition",
        "index",
        "written_by"
      ],
      "properties": {
        "edition": {
          "type": "string",
          "pattern": "\\{period\\}"
        },
        "index": {
          "type": "string"
        },
        "written_by": {
          "type": "string"
        }
      }
    },
    "main_resource": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Output port that summarizes the edition."
    }
  }
}
