{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:statera:schema:process:0.1",
  "title": "Process in YAML, a 1:1 mirror of BPMN 2.0",
  "description": "Source of the processes. Element types use the names of the BPMN 2.0 specification (OMG). `statera bpmn` generates the standard .bpmn (with DI) from this file; `statera bpmn import` does the reverse.",
  "type": "object",
  "required": [
    "id",
    "name",
    "lanes",
    "elements",
    "flows"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/$defs/id",
      "description": "Id of the bpmn:process."
    },
    "name": {
      "type": "string",
      "description": "Name of the participant (pool)."
    },
    "description": {
      "type": "string"
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Role from governance/roles.yaml."
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "lane"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "type": {
            "enum": [
              "startEvent",
              "endEvent",
              "intermediateCatchEvent",
              "intermediateThrowEvent",
              "task",
              "userTask",
              "serviceTask",
              "manualTask",
              "scriptTask",
              "sendTask",
              "receiveTask",
              "businessRuleTask",
              "callActivity",
              "subProcess",
              "exclusiveGateway",
              "parallelGateway",
              "inclusiveGateway",
              "eventBasedGateway"
            ]
          },
          "name": {
            "type": "string"
          },
          "lane": {
            "$ref": "#/$defs/id"
          },
          "event": {
            "enum": [
              "timer",
              "message",
              "signal"
            ],
            "description": "Event definition (e.g. timerEventDefinition)."
          },
          "documentation": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "description": "dataInputAssociation"
          },
          "outputs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "description": "dataOutputAssociation"
          },
          "column": {
            "type": "integer",
            "minimum": 0,
            "description": "Optional: forces the column in the diagram."
          },
          "statera": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "automatic",
                  "semi-automatic",
                  "manual"
                ]
              },
              "gsbpm": {
                "type": "string",
                "pattern": "^\\d\\.\\d+([-;]\\d\\.\\d+)*$"
              },
              "durationMin": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "implementation": {
                "type": "string",
                "pattern": "^((py|dbt):.+|[A-Z][A-Za-z0-9_]*)$",
                "description": "The class of the step (statera.extend Task: the product's, in <phase>/tasks.py, or the framework's: Gate, DbtBuild, Extract, Package, Publish, MarkCut, Evaluate). `py:<module>.<function>` (deprecated) and `dbt:build` remain accepted."
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exception": {
                "type": "boolean"
              },
              "awaits": {
                "type": "string",
                "pattern": "^(py:[A-Za-z_][\\w.]*|[A-Z][A-Za-z0-9_]*)$",
                "description": "On an intermediate event: the Await class that says whether the wait is over (the framework's PinCut: the cut of the input internal products, 09). `py:<module>.<function>` (deprecated) remains accepted."
              },
              "params": {
                "type": "object",
                "description": "Parameters given to the step's class (ctx.params)."
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^CK-[0-9]{2}$"
                },
                "uniqueItems": true,
                "description": "On a gate: the controls (ids in 6-analyse/controls.yaml) it runs; all of them when omitted."
              }
            }
          }
        }
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "type": {
            "enum": [
              "dataStoreReference",
              "dataObjectReference"
            ]
          },
          "name": {
            "type": "string"
          },
          "asset": {
            "type": "string",
            "description": "Id of the corresponding ODCS contract, if any."
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "from": {
            "$ref": "#/$defs/id"
          },
          "to": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "condition": {
            "type": "string",
            "pattern": "^[a-z-]+$",
            "description": "Status of the last task that makes the executor follow this flow (ok, failed, approved, rejected)."
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    }
  }
}
