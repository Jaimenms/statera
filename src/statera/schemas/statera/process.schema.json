{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:statera:schema:process:0.1",
  "title": "Processo em YAML, espelho 1:1 do BPMN 2.0",
  "description": "Fonte dos processos. Os tipos de elemento usam os nomes da especificação BPMN 2.0 (OMG). `statera bpmn` gera o .bpmn padrão (com DI) a partir deste arquivo; `statera bpmn import` faz o caminho inverso.",
  "type": "object",
  "required": [
    "id",
    "name",
    "lanes",
    "elements",
    "flows"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/$defs/id",
      "description": "Id do bpmn:process."
    },
    "name": {
      "type": "string",
      "description": "Nome do participante (pool)."
    },
    "description": {
      "type": "string"
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Papel de governance/roles.yaml."
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "lane"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "type": {
            "enum": [
              "startEvent",
              "endEvent",
              "intermediateCatchEvent",
              "intermediateThrowEvent",
              "task",
              "userTask",
              "serviceTask",
              "manualTask",
              "scriptTask",
              "sendTask",
              "receiveTask",
              "businessRuleTask",
              "callActivity",
              "subProcess",
              "exclusiveGateway",
              "parallelGateway",
              "inclusiveGateway",
              "eventBasedGateway"
            ]
          },
          "name": {
            "type": "string"
          },
          "lane": {
            "$ref": "#/$defs/id"
          },
          "event": {
            "enum": [
              "timer",
              "message",
              "signal"
            ],
            "description": "Definição do evento (ex.: timerEventDefinition)."
          },
          "documentation": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "description": "dataInputAssociation"
          },
          "outputs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "description": "dataOutputAssociation"
          },
          "column": {
            "type": "integer",
            "minimum": 0,
            "description": "Opcional: força a coluna no diagrama."
          },
          "statera": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "automatic",
                  "semi-automatic",
                  "manual"
                ]
              },
              "gsbpm": {
                "type": "string",
                "pattern": "^\\d\\.\\d+([-;]\\d\\.\\d+)*$"
              },
              "durationMin": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "implementation": {
                "type": "string",
                "pattern": "^(py|dbt):.+"
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exception": {
                "type": "boolean"
              },
              "awaits": {
                "type": "string",
                "pattern": "^py:[A-Za-z_][\\w.]*$",
                "description": "Em evento intermediário: função que diz se a espera terminou (ex.: o corte do produto interno de entrada foi liberado)."
              }
            }
          }
        }
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "type": {
            "enum": [
              "dataStoreReference",
              "dataObjectReference"
            ]
          },
          "name": {
            "type": "string"
          },
          "asset": {
            "type": "string",
            "description": "Id do contrato ODCS correspondente, se houver."
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "from": {
            "$ref": "#/$defs/id"
          },
          "to": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "condition": {
            "type": "string",
            "pattern": "^[a-z-]+$",
            "description": "Situação da última tarefa que faz o executor seguir este fluxo (ok, falha, aprovado, reprovado)."
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    }
  }
}
