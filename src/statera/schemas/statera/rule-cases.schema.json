{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:statera:schema:rule-cases:0.1",
  "title": "Casos executáveis de uma regra de negócio",
  "description": "Cada caso vira um unit test do dbt (statera rules sync).",
  "type": "object",
  "required": [
    "rule",
    "model",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "rule": {
      "type": "string",
      "pattern": "^RN-[A-Z]+-[0-9]{3}$"
    },
    "model": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "variables": {
      "type": "object"
    },
    "requires": {
      "type": "array",
      "items": {
        "enum": [
          "pspp",
          "r"
        ]
      },
      "description": "Ferramentas externas que o modelo usa: pspp (sintaxe SPSS legada) ou r (script R legado). Sem elas, os casos não rodam localmente; o CI as instala e exige."
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "inputs",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "inputs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "expected": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
