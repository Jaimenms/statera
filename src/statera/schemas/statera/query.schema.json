{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:statera:schema:query:0.1",
  "title": "Cataloged recurring query (five catalog axes: theme, product, datasets, frequency and purpose)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "theme",
    "bases",
    "frequency",
    "purpose",
    "parameters",
    "limitations",
    "output_classification",
    "owner",
    "status",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z0-9-]+)+\\.query\\.[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "theme": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "product": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9-]+$"
    },
    "bases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(bronze|silver|gold|ref)\\.[a-z0-9_]+$"
      }
    },
    "frequency": {
      "enum": [
        "on-demand",
        "monthly",
        "quarterly",
        "annual"
      ]
    },
    "purpose": {
      "enum": [
        "on-request",
        "study",
        "dashboard",
        "internal-control",
        "official-release"
      ]
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "type": {
            "enum": [
              "period",
              "date",
              "ibge-code",
              "uf",
              "integer",
              "short-text",
              "cut"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "default": {}
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "string"
    },
    "output_classification": {
      "type": "object",
      "required": [
        "sharing",
        "nature",
        "secrecy"
      ],
      "additionalProperties": false,
      "properties": {
        "sharing": {
          "enum": [
            "broad",
            "restricted",
            "specific"
          ],
          "description": "Sharing level (in Brazil, the levels of Decree No. 10,046/2019)."
        },
        "nature": {
          "enum": [
            "aggregated",
            "deidentified",
            "personal",
            "sensitive-personal"
          ],
          "description": "Nature of the data under data protection law (e.g. LGPD in Brazil, GDPR in the EU)."
        },
        "secrecy": {
          "enum": [
            "none",
            "statistical",
            "tax",
            "other"
          ],
          "description": "Confidentiality under specific legislation (e.g. statistical or tax secrecy; LAI in Brazil)."
        },
        "disclosureControl": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "method",
                "column",
                "minimum",
                "suppressedColumns"
              ],
              "additionalProperties": false,
              "description": "Cell suppression for aggregate tables: suppresses the measures where the count falls below the minimum.",
              "properties": {
                "method": {
                  "const": "cell-suppression"
                },
                "column": {
                  "type": "string"
                },
                "minimum": {
                  "type": "integer",
                  "minimum": 1
                },
                "suppressedColumns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "unpublishedColumns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "method",
                "k",
                "quasiIdentifiers",
                "suppressibleColumns"
              ],
              "additionalProperties": false,
              "description": "k-anonymity with local suppression, for de-identified microdata: every combination of quasi-identifiers appears in at least k records. Where it does not, blanks the values of the suppressible columns, in order; whatever is still below k is removed.",
              "properties": {
                "method": {
                  "const": "k-anonymity"
                },
                "k": {
                  "type": "integer",
                  "minimum": 2
                },
                "quasiIdentifiers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "description": "Columns that, combined, could identify a person (municipality, occupation, age, sex…)."
                },
                "suppressibleColumns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "description": "Quasi-identifiers that may be blanked, from most to least specific."
                },
                "unpublishedColumns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "authors": {
      "type": "array",
      "description": "Who produced the query (credit to people), besides the owner role. Includes people outside the data team.",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "contact": {
            "type": "string",
            "format": "email"
          }
        }
      }
    },
    "status": {
      "enum": [
        "exploratory",
        "cataloged",
        "certified",
        "deprecated"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
