{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:statera:schema:metrics:0.1",
  "title": "Official metrics of a product (inspired by the dbt/MetricFlow semantic layer)",
  "type": "object",
  "required": [
    "metrics"
  ],
  "additionalProperties": false,
  "properties": {
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "label",
          "description",
          "type",
          "time"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "enum": [
              "simple",
              "ratio"
            ]
          },
          "aggregation": {
            "enum": [
              "sum",
              "average",
              "min",
              "max",
              "count"
            ]
          },
          "numerator": {
            "type": "string"
          },
          "denominator": {
            "type": "string"
          },
          "factor": {
            "type": "number"
          },
          "time": {
            "type": "string"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "table",
                "dimensions"
              ],
              "additionalProperties": false,
              "properties": {
                "table": {
                  "type": "string",
                  "pattern": "^(silver|gold)\\.[a-z0-9_]+$"
                },
                "dimensions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "expression": {
            "type": "string",
            "description": "Column or SQL expression over source columns, aggregated by `aggregation`."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "simple"
                }
              }
            },
            "then": {
              "required": [
                "aggregation",
                "expression",
                "sources"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "ratio"
                }
              }
            },
            "then": {
              "required": [
                "numerator",
                "denominator"
              ]
            }
          }
        ]
      }
    }
  }
}
