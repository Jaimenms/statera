{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:statera:schema:classification:0.1",
  "title": "Approval of the classification of a unit's assets (sharing, nature, confidentiality and disclosure control)",
  "description": "Maintained by the data protection officer. Each asset repeats the classification in its ODCS contract; CI requires them to match.",
  "type": "object",
  "required": [
    "unit",
    "reviewed_on",
    "approved_by",
    "assets"
  ],
  "additionalProperties": false,
  "properties": {
    "unit": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "approved_by": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "contract",
          "sharing",
          "nature",
          "secrecy",
          "legal_basis"
        ],
        "additionalProperties": false,
        "properties": {
          "contract": {
            "type": "string"
          },
          "sharing": {
            "enum": [
              "broad",
              "restricted",
              "specific"
            ],
            "description": "Sharing level (in Brazil, the levels of Decree No. 10,046/2019)."
          },
          "nature": {
            "enum": [
              "aggregated",
              "deidentified",
              "personal",
              "sensitive-personal"
            ],
            "description": "Nature of the data under data protection law (e.g. LGPD in Brazil, GDPR in the EU)."
          },
          "secrecy": {
            "enum": [
              "none",
              "statistical",
              "tax",
              "other"
            ],
            "description": "Confidentiality under specific legislation (e.g. statistical or tax secrecy; LAI in Brazil)."
          },
          "disclosure_control": {
            "enum": [
              "cell-suppression",
              "k-anonymity"
            ],
            "description": "Statistical disclosure control method (GSBPM 6.4)."
          },
          "legal_basis": {
            "type": "string",
            "minLength": 3
          }
        },
        "if": {
          "properties": {
            "secrecy": {
              "const": "statistical"
            }
          }
        },
        "then": {
          "required": [
            "disclosure_control"
          ]
        }
      }
    }
  }
}
